#!/bin/sh
# BioLabCalc Standalone CLI Entrypoint
# Cross-platform POSIX launcher for Linux, macOS, WSL, MSYS2, and Git Bash.

set -e

# Resolve Python interpreter
if command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON_CMD="python"
elif command -v py >/dev/null 2>&1; then
    PYTHON_CMD="py -3"
else
    echo "Error: Python 3 is required but neither 'python3' nor 'python' was found in PATH." >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
exec $PYTHON_CMD "$SCRIPT_DIR/run.py" "$@"
